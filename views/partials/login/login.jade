div.login-register-dialog
	div.modal-body.clearfix
		form.login-form(ng-controller="LoginController", ng-submit="login()", name="form", novalidate)
			fieldset
				legend Já sou cadastrado

				div.alert.alert-danger(ng-show="errorMessage")
					b {{errorMessage}}

				div.form-group
					label(for="email") Email
					input.form-control(type="email", name="email", placeholder="email@dominio.com", ng-disabled="processing", ng-model="email", required)

				div.form-group
					label(for="password") Senha
					input.form-control(type="password", name="password", placeholder="Senha", ng-disabled="processing", ng-model="password", required)

				div.checkbox
					label
						input(type="checkbox", ng-model="keepLoggedIn")
						span manter-me conectado

				button.btn.btn-block.btn-primary(type="submit", ng-disabled="processing") Entrar

		form.register-form(name="form", novalidate)
			fieldset
				legend Quero me cadastrar

				div.alert.alert-danger(ng-show="errorMessage")
					b {{errorMessage}}

				div.form-group
					label(for="name") Nome
					input.form-control(type="text", name="name", placeholder="Nome", ng-disabled="processing", ng-model="name", required)

				div.form-group
					label(for="email") Seu email
					input.form-control(type="email", name="email", placeholder="email@dominio.com", ng-disabled="processing", ng-model="email", required)

				div.form-group
					label(for="password") Sua senha
					input.form-control(type="password", name="password", placeholder="senha", ng-disabled="processing", ng-model="password", required)

				button.btn.btn-block.btn-success(type="submit", ng-disabled="processing") Cadastrar